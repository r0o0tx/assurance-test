flowchart TB
  client([Internet clients])

  subgraph RG[Resource group rg-assurance-test-ENV-aks - local state]
    direction TB

    subgraph AKS[AKS cluster - 3 zones - Azure CNI overlay - autoscale 2-4]
      websvc["Service web-public<br/>Standard LoadBalancer"]
      webdep["Deployment web<br/>rolling update - HPA - probes"]
      apisvc["Service api (ClusterIP)<br/>in-cluster east-west"]
      apidep["Deployment api<br/>rolling update - HPA - probes"]
    end

    db[("PostgreSQL Flexible Server<br/>private - zone-redundant HA - TLS only")]
    id["Kubelet managed identity<br/>AcrPull on shared registry"]
